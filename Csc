#include <iostream>

using namespace std;

int main() {
    long long number;

    cout << "Enter an integer: ";
    if (!(cin >> number)) {
        cerr << "Invalid input. Please enter a valid integer." << endl;
        return 1;
    }

    // Checking == 0 works accurately for positive, negative, and zero inputs
    if (number % 2 == 0) {
        cout << number << " is Even." << endl;
    } else {
        cout << number << " is Odd." << endl;
    }

    return 0;
}
